{
  "name": "dual-live-translations",
  "version": "0.1.0",
  "private": true,
  "description": "LingoLoop dual-subtitle video studio with loop-first study tools",
  "author": "ryuuna",
  "main": "main/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:hybrid": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build --webpack && electron-builder",
    "electron:pack": "electron-builder --dir"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/generative-ai": "^0.24.1",
    "@xenova/transformers": "^2.17.2",
    "concurrently": "^9.2.1",
    "ffmpeg-static": "^5.3.0",
    "google-translate-api-next": "^0.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "wait-on": "^9.0.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4"
  },
  "build": {
    "appId": "com.ryuuna.duallivetranslations",
    "productName": "LingoLoop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "package.json",
      "node_modules/**/*",
      ".next/**/*",
      "public/**/*",
      "bin/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**",
      "node_modules/@xenova/transformers/**",
      "node_modules/onnxruntime-node/**"
    ]
  }
}
